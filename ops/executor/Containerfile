FROM --platform=$BUILDPLATFORM golang:1.27.4-bookworm@sha256:4fa7c968ba93f1635670522dbb01a2c78150443e1385746924566079f36570ea AS helm-preview
ARG TARGETARCH
ENV CGO_ENABLED=0 GOTOOLCHAIN=local
WORKDIR /src
COPY ops/executor/preview/go.mod ops/executor/preview/go.sum ./
RUN go mod download && go mod verify
COPY ops/executor/preview/main.go ./
RUN --network=none GOOS=linux GOARCH="$TARGETARCH" go build -mod=readonly -trimpath -buildvcs=false \
      -ldflags="-s -w" -o /out/jaeger-helm-preview .

FROM python:3.13-slim-bookworm@sha256:a5a7017efc5969e00ae2b91c8eb0631049a569652aa4ffc4501769049ae45c72
ARG TARGETARCH
RUN apt-get update && apt-get install -y --no-install-recommends bash ca-certificates curl git jq \
    && rm -rf /var/lib/apt/lists/*
RUN set -eu; case "$TARGETARCH" in \
      amd64) helm_sum=d1c0278d46beab79582d7e50f5b3dc206944ba8e577cde618513fd07daa53983; kube_sum=6129359f4e1f3848a5572ccb0b26cf28b8ca08cef38c95a765b2f64a2c961a2f ;; \
      arm64) helm_sum=df31cb61680ef728f82c770e5280dd565617bee6b039d37e85c677288be4bbb0; kube_sum=922df28df248cc00a9e025f947704f1d1482de64ece54cfe57e61f19eaf1eef3 ;; \
      *) exit 1 ;; esac; \
    cd /tmp; curl -fsSLo helm.tgz "https://get.helm.sh/helm-v4.3.2-linux-${TARGETARCH}.tar.gz"; \
    curl -fsSLo kubectl "https://dl.k8s.io/release/v1.37.0/bin/linux/${TARGETARCH}/kubectl"; \
    printf '%s  %s\n' "$helm_sum" helm.tgz "$kube_sum" kubectl | sha256sum -c -; \
    tar -xzf helm.tgz "linux-${TARGETARCH}/helm"; \
    install -m 0755 "linux-${TARGETARCH}/helm" kubectl /usr/local/bin/; \
    rm -rf "linux-${TARGETARCH}" helm.tgz kubectl
WORKDIR /opt/jaeger-demo
COPY --from=helm-preview /out/jaeger-helm-preview /usr/local/bin/jaeger-helm-preview
COPY ops/executor/preview/ ops/executor/preview/
RUN python3 ops/executor/preview/check-abi.py /usr/local/bin/jaeger-helm-preview
COPY ops/executor/requirements.lock ops/executor/requirements.lock
RUN pip install --no-cache-dir --no-deps --only-binary=:all: --require-hashes -r ops/executor/requirements.lock
COPY scripts/demo/ scripts/demo/
COPY scripts/utils/resolve-demo-snapshot-tags.sh scripts/utils/resolve-demo-snapshot-tags.sh
COPY docs/all-five-chart-access.json docs/all-five-chart-access.json
COPY examples/oci/ examples/oci/
COPY examples/otel-demo/ examples/otel-demo/
COPY ops/executor/chart-archives.json ops/executor/chart-archives.json
COPY ops/executor/Containerfile ops/executor/Containerfile
ENV HOME=/tmp/home PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
USER 10001:10001
ENTRYPOINT ["python3","/opt/jaeger-demo/scripts/demo/scheduled_receiver.py"]
